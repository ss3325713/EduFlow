# ============================================================
# EDUFLOW ACADEMY — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to '.env' in local development or set these variables
# in your production environment (Render, Railway, AWS, Heroku, VPS).
# NEVER commit real credentials or private keys to source control.

# Application Secrets
SECRET_KEY=eduflow-secret-key-super-secure-change-in-prod-2026
JWT_SECRET_KEY=jwt-eduflow-api-secret-key-2026
FLASK_ENV=development

# Database Connection
# SQLite default: sqlite:///eduflow.db
# PostgreSQL example: postgresql://user:password@localhost:5432/eduflow_db
DATABASE_URL=sqlite:///eduflow.db

# Centralized SMTP Email Service
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply.vista@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_USE_TLS=true

# Sender Identity
MAIL_FROM_ADDRESS=noreply.vista@gmail.com
MAIL_FROM_NAME=EduFlow Notifications

# Base URL for Email Links & Redirects
APP_BASE_URL=http://localhost:5000
